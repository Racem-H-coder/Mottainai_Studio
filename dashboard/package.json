{
  "name": "tameru-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "tools\\.venv\\Scripts\\python.exe tools\\export_data.py",
    "validate": "node tools/validate_data.ts",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build": "npm run validate && tsc -p tsconfig.json && vite build",
    "build:single": "npm run validate && tsc -p tsconfig.json && vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "test": "node tools/run-vitest.mjs run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chart.js": "^4.6.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "4.1.12"
  }
}
